  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "json-server": "^0.17.4",
    "sass": "^1.80.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
